generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Todo {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  completed   Boolean  @default(false)
  priority    Int      @default(1)
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
